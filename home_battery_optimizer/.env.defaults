# Installation settings (loaded by config.py). Committed defaults with every
# key. Put local values and secrets (HA_TOKEN) in .env next to this file: it is
# git-ignored and wins over this file. A variable already set in the process
# environment wins over both. Restart the service after a change.

# ── Home Assistant ─────────────────────────────────────────────────────────
HA_URL=https://ha.kompfix.pl
# Long-lived access token. Set it in .env; a request's ha_token still wins.
HA_TOKEN=

# ── Pstryk AIO purchase price sensors (today_prices / tomorrow_prices) ─────
PRICE_TODAY_ENTITY=sensor.pstryk_aio_obecna_cena_zakupu_pradu
PRICE_TOMORROW_ENTITY=sensor.pstryk_aio_cena_zakupu_pradu_jutro
# true = plan with the shield-capped purchase price (price_shield attribute).
# auto = do so only while the shield is active: the monthly average energy
# price (state of PRICE_MONTHLY_AVG_ENTITY) is above the shield price (its
# price_shield attribute).
PRICE_SHIELD=false
PRICE_MONTHLY_AVG_ENTITY=sensor.kotlownia_pstryk_aio_miesieczna_srednia_cena_energii

# ── Inverter (DessMonitor integration, SandiSolar 11 kW) ───────────────────
# Replaced the retired "Solar of Things" sensor.gniazdo_* entities in 2026-09.
BATTERY_VOLTAGE_ENTITY=sensor.inverter_e50000254944442369_dessmonitor_battery_voltage
# DessMonitor reports output power in W; the whole optimizer works in kW.
INVERTER_OUTPUT_POWER_ENTITY=sensor.inverter_e50000254944442369_dessmonitor_output_power
# Lifetime PV yield counter (kWh, total_increasing): measured production for
# the prediction-vs-reality reconciliation.
PV_ENERGY_TOTAL_ENTITY=sensor.inverter_e50000254944442369_dessmonitor_energy_total
# PV made per hour (hourly "change" of the daily counter) and the BMS SOC,
# for the intraday forecast correction.
PV_ENERGY_TODAY_ENTITY=sensor.inverter_e50000254944442369_dessmonitor_energy_today

# ── JK BMS ─────────────────────────────────────────────────────────────────
# JK BMS (template helpers over sensor.jk_bms). The helper goes "unavailable"
# once sensor.jk_bms has been silent for 60 s (BLE dropouts of ~8 min seen).
BMS_SOC_ENTITY=sensor.jk_bms_soc

# ── PV forecast (kWh per day, hourly split in attributes) ──────────────────
SOLAR_FORECAST_TODAY_ENTITY=sensor.dom_energy_production_today
SOLAR_FORECAST_TOMORROW_ENTITY=sensor.dom_energy_production_tomorrow
SOLAR_FORECAST_D2_ENTITY=sensor.dom_energy_production_d2

# ── Battery, inverter and grid model (battery_model.py) ────────────────────
# 16s LiFePo4 pack: nominal voltage (V) and cell capacity (Ah).
NOMINAL_VOLTAGE=52.0
CAPACITY_AH=320
# Pack voltage (V) read as 0 % and 100 % SOC while the BMS is silent.
VOLTAGE_MIN=48.0
VOLTAGE_MAX=56.0
# Reserve the plan never goes below and the top of charge (% SOC). A request's
# min_soc_pct / max_soc_pct still wins.
MIN_SOC_PCT=10
MAX_SOC_PCT=95
# Share of the energy that survives charging and discharging (0–1).
CHARGE_EFFICIENCY=0.95
DISCHARGE_EFFICIENCY=0.95
# Inverter ceilings (A): grid charging, and PV + grid together.
MAX_CHARGE_CURRENT_A=80
MAX_TOTAL_CHARGE_CURRENT_A=150
# Ceiling on grid → battery power (kW); above what 80 A draws, so not binding.
MAX_CHARGE_POWER_KW=5.0
# Grid connection (kW): one phase, 25 A breaker × 230 V.
GRID_LIMIT_KW=5.75
# Negative-price dummy load on its own circuit (kW); 0 = no such circuit.
DUMMY_LOAD_KW=4.5

# ── Dashboard helpers ──────────────────────────────────────────────────────
# Dashboard helpers holding the end-of-day SOC target (%) for today and
# tomorrow; -1 = automatic.  Read on every run so each request plans with both.
SOC_TARGET_TODAY_ENTITY=input_number.soc_target_today
SOC_TARGET_TOMORROW_ENTITY=input_number.soc_target_tomorrow

# ── Service ────────────────────────────────────────────────────────────────
# SQLite prediction store; empty = home_battery_optimizer/data/history.db.
BATTERY_HISTORY_DB=
